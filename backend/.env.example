# Backend environment variables. Copy to .env and adjust for your machine.

# --- Application ---
PROJECT_NAME=AI SOC Analyst
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS (comma-separated) ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL / pgvector ---
# Use POSTGRES_HOST=postgres when running the backend inside Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=soc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soc_analyst
EMBEDDING_DIMENSIONS=1536

# --- Redis ---
# Use REDIS_HOST=redis when running the backend inside Docker Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
